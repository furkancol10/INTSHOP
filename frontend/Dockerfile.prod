# Uretim yapisi: statik build + nginx ile sun (Vite dev server DEGIL).
# Yerel gelistirme icin mevcut Dockerfile (npm run dev + volume mount) kullanilir.
# Kullanim:
#   docker build -f frontend/Dockerfile.prod \
#     --build-arg VITE_API_URL=https://api.example.com -t stok-frontend-prod ./frontend
#   docker run -p 8080:80 stok-frontend-prod

FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# API adresi build aninda gomulur; deploy hedefine gore verin.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:alpine
# Statik ciktilar; nginx varsayilan olarak index.html sunar (SPA tek sayfa).
COPY --from=build /app/dist /usr/share/nginx/html
# NOT: Uretimde CSP/HSTS gibi guvenlik basliklarini nginx konfigurasyonunda
# ekleyin (add_header). API JSON'undaki CSP frontend HTML'ini korumaz.
EXPOSE 80
